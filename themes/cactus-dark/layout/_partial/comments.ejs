<% if(page.comments && theme.cusdis.host){ %>
    <div id="comments-container">
        <h1>Comments</h1>
        <div id="cusdis_thread" data-host="<%- theme.cusdis.host %>" data-app-id="<%- theme.cusdis.app_id %>" data-page-id="<%- page.path %>" data-page-url="<%- page.permalink %>" data-page-title="<%- page.title %>" data-theme="dark"></div>
    </div>

    <script async defer src="js/cusdis.es.js"></script>  <!-- copied from https://cusdis.muetsch.io/js/cusdis.es.js -->
    <script async defer src="js/cusdis.js"></script>
<% } %>